# Godot 4+ specific ignores
.godot/
# Android build template is generated by Godot - ignore it, EXCEPT our own Java sources
/android/*
!/android/build/
/android/build/*
!/android/build/src/
/android/build/src/*
!/android/build/src/main/
/android/build/src/main/*
!/android/build/src/main/java/
/android/build/src/main/java/*
!/android/build/src/main/java/com/
/android/build/src/main/java/com/*
!/android/build/src/main/java/com/godot/
/android/build/src/main/java/com/godot/*
!/android/build/src/main/java/com/godot/game/
/android/build/src/main/java/com/godot/game/*
!/android/build/src/main/java/com/godot/game/HeadsetCameraBridge.java
!/android/build/src/main/java/com/godot/game/PuttTracker.java

# Python & Virtual Environments
__pycache__/
*.pyc
.venv/
tools/optical_tracker/.venv/
# Build outputs & APKs (root build folder only - android/build is handled above)
/build/
*.apk

# Temporary Engine Dumps & API dumps
extension_api.json
dump_api.gd

# Scratch & capture review dumps (camera frames, JPGs, import artifacts)
scratch/
captures_review*/
tools/optical_tracker/captures/
builds/

# Pulled Quest sessions, recordings, and debug dumps
tools/sessions/
tools/recordings/
putt_log_*.txt
*.log

# LLM / Claude working artifacts
Claude outputs/

# Replay tool build output
/tools/replay/build/
